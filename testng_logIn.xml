<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Suite">

	<groups>
    	<run>
      		<include name="regression"/>
      		<include name="smoke"/>
    	</run>
  	</groups>
  	
  	<listeners>
		<listener class-name="swag.lab.listeners.TestListener"/>
	</listeners>
	
	<listeners>
    	<listener class-name="io.qameta.allure.testng.AllureTestNg"/>
	</listeners>
  

   <test thread-count="5" name="Submit Order Test">   
    
    <classes>	     
      <class name = "swag.lab.tests.LoginTest"/>
    </classes>
    
    
  </test> <!-- Test -->
  
  
  
</suite> <!-- Suite -->
